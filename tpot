#!/usr/bin/env python3
"""tpot - configure and run T-Pot. `tpot -h` lists the commands, `tpot` opens the menu.

The installer links this file to /usr/local/bin/tpot. It only uses the standard
library and runs everything else from the venv of tpot (tpotctl/bootstrap.py).
"""

import os
import sys

REPO_DIR = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, REPO_DIR)

from tpotctl import bootstrap, prefs, say  # noqa: E402


def fail(text, code=2):
    say.error(text)
    sys.exit(code)


def main():
    argv = sys.argv[1:]
    if hasattr(os, "geteuid") and os.geteuid() == 0:
        fail("do not run tpot as root, it calls sudo itself where needed")
    # the colours chosen (TPOT_COLORS, prefs) reach Textual before anything imports it
    prefs.apply_color_system(os.environ)
    home = os.path.join(os.path.expanduser("~"), "tpotce")
    on_host = sys.platform.startswith("linux")
    if on_host and not os.environ.get(bootstrap.GUARD) and os.path.realpath(home) != REPO_DIR:
        say.warn(f"tpot runs from {REPO_DIR}, but T-Pot's scripts expect {home}.", sys.stderr)
    # update and restore must work even when the venv is broken
    if argv[:1] in (["update"], ["restore"]):
        from tpotctl import cli
        sys.exit(cli.main(argv))
    # ./tpot (the menu) or ./tpot setup from ~/tpotce without the link of the installer: offer it, once
    if on_host and not os.environ.get(bootstrap.GUARD) and argv[:1] in ([], ["setup"]):
        bootstrap.ensure_link(os.path.join(REPO_DIR, "tpot"))
    if argv[:1] == ["setup"]:
        try:
            python = bootstrap.setup_venv(force="--force" in argv[1:])
        except bootstrap.BootstrapError as err:
            fail(str(err), 1)
        say.ok(f"The Python packages of the T-Pot Manager are ready ({os.path.dirname(os.path.dirname(python))}).")
        sys.exit(0)
    try:
        python = bootstrap.ensure("ui")
    except bootstrap.BootstrapError as err:
        fail(str(err), 1)
    if python:
        sys.exit(bootstrap.reexec(python, os.path.realpath(__file__), argv))
    from tpotctl import cli
    sys.exit(cli.main(argv))


if __name__ == "__main__":
    main()
