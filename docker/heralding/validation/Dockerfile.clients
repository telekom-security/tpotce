FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends freerdp2-x11 xvfb xauth nmap hydra smbclient hashcat sipsak openssl python3 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12@sha256:f513a91fc62fe7c17567eee97230dd198e43edb8a9fbecca843714a4358fe1bc /uv /usr/local/bin/uv
RUN uv venv --python /usr/bin/python3 /opt/clients \
    && uv pip install --python /opt/clients/bin/python pymysql==1.2.3 smbprotocol==1.17.0 ldap3==2.9.1 paho-mqtt==2.1.0 asyncssh==2.24.0 psycopg[binary]==3.3.3 redis==8.0.0 python-tds==1.17.1 vncdotool==1.3.0
ENV PATH=/opt/clients/bin:$PATH
