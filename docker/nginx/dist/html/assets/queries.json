                        "min": "now-24h",
                        "max": "now"
                      }
                    }
                  }
                }
              },
              "sources": {
                "cardinality": {
                  "field": "src_ip.keyword"
                }
              },
              "honeypots": {
                "cardinality": {
                  "field": "type.keyword"
                }
              }
            }
          },
          "previous": {
            "filter": {
              "range": {
                "@timestamp": {
