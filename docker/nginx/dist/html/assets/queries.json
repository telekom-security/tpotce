      "lists": 60,
      "name": "the last 24 hours",
      "short": "24 h",
      "per": "30 min",
      "overview": {
        "size": 0,
        "query": {
          "bool": {
            "filter": [
              {
                "range": {
                  "@timestamp": {
                    "gte": "now-48h"
                  }
                }
              },
              {
                "bool": {
                  "must_not": {
                    "terms": {
                      "type.keyword": [
                        "Suricata",
                        "P0f"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "aggs": {
          "current": {
            "filter": {
              "range": {
                "@timestamp": {
                  "gte": "now-24h"
                }
              }
            },
            "aggs": {
              "slots": {
                "date_histogram": {
                  "field": "@timestamp",
                  "fixed_interval": "30m",
                  "min_doc_count": 0,
                  "extended_bounds": {
                    "min": "now-24h",
                    "max": "now"
                  }
                }
              },
              "types": {
                "terms": {
                  "field": "type.keyword",
                  "size": 7
