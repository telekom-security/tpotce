+++ b/tests/test_cowrie.py
@@ -0,0 +1,107 @@
+import importlib.util
+import os
+import sys
+import types
+import unittest
+from unittest import mock
+
+
+MODULE_PATH = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "honeypots", "cowrie.py")
+
+
+def load_cowrie():
+    """ load honeypots/cowrie.py with a stand-in for modules.ealert, sys.modules stays as it was """
+    modules = types.ModuleType("modules")
+    ealert = types.ModuleType("modules.ealert")
+    ealert.EAlert = object
+    with mock.patch.dict(sys.modules, {"modules": modules, "modules.ealert": ealert}):
+        spec = importlib.util.spec_from_file_location("cowrie_under_test", MODULE_PATH)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+    return module
+
+
+cowrie_module = load_cowrie()
+
+
+class FakeEAlert:
+    """ records the alerts cowrie() builds from the given log lines """
+
+    lines = []
+    alerts = []
+
+    def __init__(self, MODUL, ECFG):
+        self.queue = list(self.lines)
+        self.current = {}
+
+    def readCFG(self, items, cfgfile):
+        return {"cowrie": "true", "nodeid": "cowrie-test", "logfile": "cowrie.json"}
+
+    def fileIndex(self, name, action, session=None):
+        return []
+
+    def alertCount(self, section, counting, item="index"):
+        return ()
+
+    def lineREAD(self, filename, mode):
+        return self.queue.pop(0) if self.queue else ()
+
+    def data(self, key, value):
+        self.current[key] = value
+
+    def request(self, key, value):
+        self.current[key] = value
+
+    def adata(self, key, value):
+        self.current[key] = value
+
+    def buildAlert(self):
+        self.alerts.append(self.current)
+        self.current = {}
+
+    def finAlert(self):
+        return ()
+
+
+ECFG = {"cfgfile": "ews.cfg", "hostname": "host", "ip_ext": "192.0.2.100", "ip_int": "10.0.0.2", "uuid": "uuid"}
+
+
+def connect(session, dst_port, protocol=None):
+    line = {"eventid": "cowrie.session.connect", "session": session, "timestamp": "2026-10-12T10:00:00.000000Z",
+            "src_ip": "192.0.2.1", "src_port": 40000, "dst_ip": "10.0.0.2", "dst_port": dst_port}
+    if protocol is not None:
+        line["protocol"] = protocol
+    return line
+
+
+class DescriptionTest(unittest.TestCase):
+    def run_cowrie(self, lines):
+        FakeEAlert.lines = lines
+        FakeEAlert.alerts = []
+        with mock.patch.object(cowrie_module, "EAlert", FakeEAlert):
+            cowrie_module.cowrie(ECFG)
+        return {alert["sessionid"]: alert["description"] for alert in FakeEAlert.alerts}
+
+    def test_integer_ports(self):
+        labels = self.run_cowrie([connect("s22", 22), connect("s23", 23), connect("s2323", 2323)])
+        self.assertEqual(labels, {"s22": "SSH Honeypot Cowrie", "s23": "Telnet Honeypot Cowrie",
+                                  "s2323": "Telnet Honeypot Cowrie"})
+
+    def test_string_ports(self):
+        labels = self.run_cowrie([connect("s22", "22"), connect("s23", "23")])
+        self.assertEqual(labels, {"s22": "SSH Honeypot Cowrie", "s23": "Telnet Honeypot Cowrie"})
+
+    def test_protocol_wins_over_port(self):
+        labels = self.run_cowrie([connect("t2223", 2223, "telnet"), connect("s23", 23, "ssh")])
+        self.assertEqual(labels, {"t2223": "Telnet Honeypot Cowrie", "s23": "SSH Honeypot Cowrie"})
+
+    def test_target_port_is_kept(self):
+        FakeEAlert.lines = [connect("s23", 23, "telnet")]
+        FakeEAlert.alerts = []
+        with mock.patch.object(cowrie_module, "EAlert", FakeEAlert):
+            cowrie_module.cowrie(ECFG)
+        self.assertEqual(FakeEAlert.alerts[0]["target_port"], 23)
+
+
+if __name__ == "__main__":
+    unittest.main()
