  {"env": {"TERM": "xterm-256color", "LC_TERMINAL": "iTerm2"}, "prefs": {"colors": "auto"}, "expect": "truecolor", "note": "tpot.json auto: the terminal decides"},
  {"env": {"TERM": "xterm", "TPOT_COLORS": "bogus"}, "prefs": {"colors": "256"}, "expect": "256", "note": "an unknown TPOT_COLORS is none, tpot.json counts"},
  {"env": {"TERM": "xterm-256color", "TPOT_COLORS": "bogus"}, "prefs": {"colors": "sepia"}, "expect": "256", "note": "an unknown value in tpot.json is none too"},
  {"env": {"TERM": "xterm-256color", "STY": "1234.pts-0.host", "TERM_PROGRAM": "iTerm.app"}, "expect": "256", "note": "GNU screen with term xterm-256color in iTerm2: STY says screen, the markers of iTerm2 are only inherited"},
  {"env": {"TERM": "xterm", "STY": "1234.pts-0.host", "LC_TERMINAL": "iTerm2"}, "expect": "16", "note": "GNU screen with term xterm over SSH from iTerm2"},
  {"env": {"TERM": "xterm-256color", "STY": "1234.pts-0.host", "TERM_PROGRAM": "iTerm.app", "COLORTERM": "truecolor"}, "expect": "256", "note": "GNU screen in iTerm2, COLORTERM inherited: screen 4 cannot pass true colour (gum sees it the same way)"},
  {"env": {"TERM": "screen", "COLORTERM": "truecolor"}, "expect": "16", "note": "GNU screen over SSH with COLORTERM sent along: screen decides"},
