  {"env": {"TERM": "xterm-256color", "STY": ""}, "expect": "256", "note": "an empty STY is no screen"},
  {"env": {"TERM": "xterm-256color", "STY": "", "LC_TERMINAL": "iTerm2"}, "expect": "truecolor", "note": "an empty STY is no screen, iTerm2 over SSH"},
