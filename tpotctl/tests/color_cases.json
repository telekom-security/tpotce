  {"env": {"TERM": "dumb", "COLORTERM": "truecolor", "TERM_PROGRAM": "vscode"}, "expect": "16", "dumb": true, "note": "TERM dumb with COLORTERM: dumb wins over every marker"},
  {"env": {"TERM": "unknown", "TERM_PROGRAM": "iTerm.app"}, "expect": "16", "dumb": true, "note": "TERM unknown is dumb too (as Rich sees it)"},
  {"env": {"TERM": "DUMB", "VTE_VERSION": "7600"}, "expect": "16", "dumb": true, "note": "TERM dumb in capitals"},
  {"env": {"TERM": "dumb", "TPOT_COLORS": "256"}, "expect": "256", "dumb": true, "note": "TPOT_COLORS wins over a dumb TERM (the callers leave the colours out at a dumb terminal themselves)"},
  {"env": {"COLORTERM": "truecolor"}, "expect": "truecolor", "dumb": true, "note": "no TERM but COLORTERM: the depth is the one of COLORTERM (a console of Windows has no TERM and is not dumb), elsewhere no colours show"},
  {"env": {"TERM": ""}, "expect": "16", "dumb": true, "note": "an empty TERM is dumb, as an unset one"},
  {"env": {"TERM": "", "COLORTERM": "truecolor", "LC_TERMINAL": "iTerm2"}, "expect": "truecolor", "dumb": true, "note": "an empty TERM with the markers of a true colour terminal: no colours show, the depth stays the one of the rule"},
  {"env": {"TERM": "xterm", "NO_COLOR": "1"}, "expect": "16", "dumb": false, "note": "NO_COLOR is no dumb terminal: the colours go, bold stays (gum)"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"colors\": \"16\",}", "expect": "truecolor", "note": "tpot.json with a trailing comma is no JSON: the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"colors\": \"16\", \"colors\": \"256\"}", "expect": "256", "note": "a key twice in tpot.json: the last one counts (as in JSON)"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"look\": {\"colors\": \"16\"}}", "expect": "truecolor", "note": "colors inside another object is no choice: the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"colors\": \"\\u0031\\u0036\"}", "expect": "truecolor", "note": "escapes in tpot.json: the T-Pot Manager never writes them, the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"note\": \"a \\\"quoted\\\" word\", \"colors\": \"16\"}", "expect": "truecolor", "note": "an escaped quote in tpot.json: the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\r\n  \"icons\": \"nerd\",\r\n  \"colors\": \"256\"\r\n}\r\n", "expect": "256", "note": "tpot.json with CRLF line ends"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\n  \"icons\": \"unicode\",\n  \"colors\": \"16\"\n}\n", "expect": "16", "note": "tpot.json as the T-Pot Manager writes it"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"colors\": 16}", "expect": "truecolor", "note": "a number is no choice: the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"a: b, c\", \"colors\": \"16\"}", "expect": "16", "note": "a colon and a comma in another value"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "[\"colors\", \"16\"]", "expect": "truecolor", "note": "a list is no tpot.json"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "", "expect": "truecolor", "note": "an empty tpot.json"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"colors\": \"16\"} {\"colors\": \"256\"}", "expect": "truecolor", "note": "two objects in tpot.json: no JSON"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "\ufeff{\"colors\": \"16\"}", "expect": "truecolor", "note": "a byte order mark before tpot.json: no JSON for Python"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"colors\": \"1\n6\"}", "expect": "truecolor", "note": "a line break inside a string: no JSON"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"colors\": \"16\"\u000b}", "expect": "truecolor", "note": "a vertical tab is no space of JSON"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{}", "expect": "truecolor", "note": "an empty object: nothing chosen"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"colors\": \"16\"}\u0000{", "expect": "truecolor", "note": "a NUL byte in tpot.json: no JSON"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"a\u007fb\", \"colors\": \"16\"}", "expect": "truecolor", "note": "a DEL in a string of tpot.json: a control character, the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"a\u0085b\", \"colors\": \"16\"}", "expect": "truecolor", "note": "a C1 control character in tpot.json: the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"a\u2028b\", \"colors\": \"16\"}", "expect": "truecolor", "note": "U+2028 in tpot.json: a control character for glibc, the file does not count anywhere"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"Gr\u00f6\u00dfe \u2500\u2500 \u00a0\", \"colors\": \"16\"}", "expect": "16", "note": "letters, box characters and a no-break space in another value"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"colors\": \"16\"\t}", "expect": "16", "note": "a tab is a space of JSON"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"colors\": \"a\tb\"}", "expect": "truecolor", "note": "a tab inside a string is no JSON"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"a\udcffb\", \"colors\": \"16\"}", "expect": "truecolor", "note": "a byte that is no UTF-8 in tpot.json (a lone surrogate \\udcXX of prefs_text is that byte): the file does not count in any locale"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"a\udcc2\", \"colors\": \"16\"}", "expect": "truecolor", "note": "a UTF-8 sequence cut short in tpot.json: the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"\udcc0\udc80\", \"colors\": \"16\"}", "expect": "truecolor", "note": "an overlong UTF-8 sequence (NUL in two bytes) in tpot.json: the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"\udced\udca0\udc80\", \"colors\": \"16\"}", "expect": "truecolor", "note": "a surrogate encoded in UTF-8 in tpot.json: the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"\udcf4\udc90\udc80\udc80\", \"colors\": \"16\"}", "expect": "truecolor", "note": "a code point above U+10FFFF in tpot.json: the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"a\u0080b\", \"colors\": \"16\"}", "expect": "truecolor", "note": "U+0080, the first C1 control character, in tpot.json: the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"a\u009fb\", \"colors\": \"16\"}", "expect": "truecolor", "note": "U+009F, the last C1 control character, in tpot.json: the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"a\u2029b\", \"colors\": \"16\"}", "expect": "truecolor", "note": "U+2029 in tpot.json: a control character, the file does not count"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"\ud7ff \ue000 \uffff \ud83d\ude00 \udbff\udfff\", \"colors\": \"16\"}", "expect": "16", "note": "the edges of UTF-8 around the surrogates, of the planes and an emoji in another value"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"name\": \"colors\", \"16\": \"256\"}", "expect": "truecolor", "note": "colors as a value is no key (the string after it neither)"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"colors\": \"16\", \"name\": \"x\", \"colors\": \"256\", \"icons\": \"nerd\"}", "expect": "256", "note": "a key twice with pairs between and after them: the last one counts"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\"mycolors\": \"16\", \"colors \": \"256\"}", "expect": "truecolor", "note": "a key that only has colors in it is another key"},
  {"env": {"TERM": "xterm-256color", "COLORTERM": "truecolor"}, "prefs_text": "{\n  \"colors\"\n  :\n  \"16\"\n}", "expect": "16", "note": "the key, the colon and the value on lines of their own"}
]
